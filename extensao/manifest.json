{
  "manifest_version": 3,
  "name": "StoneFalcon 7.0",
  "version": "7.0.0",
  "description": "Copiloto do StoneFalcon: selecione um texto em qualquer página e peça a um agente. Protótipo acadêmico (UFSC).",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "action": {
    "default_title": "Abrir o copiloto do StoneFalcon",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png"
    }
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "options_page": "opcoes.html",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://docs.google.com/spreadsheets/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "botao.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
