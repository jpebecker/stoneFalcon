# Copie para ".env" para ligar os modelos de verdade. Sem ele, roda em modo simulado (sem custo).
# Defina um limite de gasto mensal na conta antes de usar.
ANTHROPIC_API_KEY=
# 1 = força o modo simulado mesmo com a chave preenchida (útil para gravar a demo)
MODO_SIMULADO=0
# Cotação usada nos custos em reais (docs/custos-estimados.txt usa 5,52)
COTACAO_DOLAR=5.52
